# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The public URL where this application is hosted.
APP_URL=

# SESSION_SECRET: Secret used to sign server-side session tokens & cookies (32+ random chars).
# If temporarily unset, the server falls back to an ephemeral per-process cryptographic secret.
SESSION_SECRET=

# FIREBASE_PROJECT_ID: Firebase Project ID used to initialize Firebase SDK on client & server.
# Falls back to firebase-applet-config.json when present.
FIREBASE_PROJECT_ID=
